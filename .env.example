# Web server
MOVIE_MAKER_HOST=127.0.0.1
MOVIE_MAKER_PORT=8090
MOVIE_MAKER_PROJECTS_DIR=./projects
# Set to 1 to exercise the full UI and FFmpeg assembly without AI services.
MOVIE_MAKER_DEMO=0

# llama.cpp's OpenAI-compatible llama-server
LLAMA_URL=http://127.0.0.1:8080
# Optional override. By default the app discovers /v1/models and lets the
# llama.cpp router autoload the selected model.
# LLAMA_MODEL=Qwen3.6-27B
# Recommended when llama.cpp and ComfyUI share a GPU. The app starts this
# command for planning and terminates it before ComfyUI begins.
# LLAMA_SERVER_COMMAND=/opt/llama.cpp/llama-server -m /models/model.gguf --port 8080
# Optional POST endpoint for an externally managed server/model loader.
# LLAMA_UNLOAD_URL=http://127.0.0.1:9000/unload

# ComfyUI
COMFY_URL=http://127.0.0.1:8188
# Optional legacy override used by the included fallback image workflow.
# COMFY_CHECKPOINT=waiIllustriousSDXL_v160.safetensors
# COMFY_SERVER_COMMAND=python /opt/ComfyUI/main.py --port 8188
# Prefer an image workflow exported with File -> Export (API).
COMFY_IMAGE_WORKFLOW=./workflows/image.json
# Export these with File -> Export (API). See README.md for supported tokens.
# A native video workflow is required. It may instead be selected from saved
# API-format ComfyUI workflows in the app's Advanced section.
# COMFY_VIDEO_WORKFLOW=./workflows/ltx-i2v-api.json
# COMFY_AUDIO_WORKFLOW=./workflows/my-audio-api.json
